    </item>
    <item>
      <title>6.6. Using Camera: UIImagePickerController</title>
      <link>//localhost:1313/docs/04-advanced-ui-components/uimenu-and-image-pickers/6.6.-using-camera-uiimagepickercontroller/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
