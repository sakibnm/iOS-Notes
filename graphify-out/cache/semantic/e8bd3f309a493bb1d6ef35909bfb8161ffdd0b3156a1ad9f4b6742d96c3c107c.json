{"nodes": [{"id": "_index_getting_started", "label": "Getting Started", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_walkthrough_exploring_getting_started", "label": "Walkthrough: Exploring Getting Started", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_preparing_your_development_environment", "label": "Preparing your Development Environment", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_mark_style_color_red_you_cannot_build_native_ios_apps_in_windows_or_linux_oss_mark", "label": "<mark style=\"color:red;\">You cannot build native iOS apps in Windows or Linux OSs.</mark>", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_mark_style_color_red_i_recommend_using_a_macbook_or_an_apple_computer_for_this_course_you_do_not_need_an_iphone_ipad_for_this_course_if_you_do_not_have_a_macbook_you_can_try_macincloud_or_even_try_borrowing_macbooks_from_the_library_i_am_not_sure_how_long_you_can_borrow_a_computer_from_there_you_can_even_talk_to_khoury_systems_to_check_if_they_lend_macbooks_for_a_semester_mark", "label": "<mark style=\"color:red;\">I recommend using a Macbook or an Apple Computer for this course. You do not need an iPhone/iPad for this course. If you do not have a Macbook, you can try MacInCloud, or even try borrowing Macbooks from the library (I am not sure how long you can borrow a computer from there). You can even talk to Khoury Systems to check if they lend Macbooks for a semester.</mark>", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_mark_style_color_red_macincloud_could_be_unstable_for_you_if_you_do_not_have_a_reliable_internet_connection_so_try_it_they_give_you_a_day_for_0_99_as_soon_as_you_register_for_the_course_if_it_works_for_you_continue_this_course_or_else_talk_to_me_mark_mark_style_color_blue_mark", "label": "<mark style=\"color:red;\">MacInCloud could be unstable for you if you do not have a reliable Internet connection. So try it (they give you a day for $0.99) as soon as you register for the course. If it works for you, continue this course, or else talk to me</mark><mark style=\"color:blue;\">.</mark>", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_mac_in_cloud", "label": "Mac In Cloud", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_setting_up_xcode", "label": "Setting up Xcode", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_index_creating_a_new_project", "label": "Creating a new project", "file_type": "document", "source_file": "content/docs/01-getting-started/_index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_index_module", "target": "_index_table_of_contents", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/docs/01-getting-started/_i